			<flow name="Births">
				<eqn>birth_rate</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Baby migration (S)">
				<eqn>baby_migration_rate</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Baby infections">
				<eqn> IF Total_infectious &gt;= 1 THEN (Total_infectious / Total_population) * &quot;Babies_(S)&quot; * Baby_inf_weight ELSE 0</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Baby recovery">
				<eqn>&quot;Babies_(I)&quot; / infection_period</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Baby hospitalisation">
				<eqn>&quot;Babies_(I)&quot; * Hosp_rate_baby</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Baby hospital recovery">
				<eqn>&quot;Babies_(H)&quot; * Recovery_from_hospital_rate</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="age up to child (R)">
				<eqn>&quot;baby_age-up_rate&quot; * &quot;Babies_(R)&quot;</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="age up to child (S)">
				<eqn>&quot;baby_age-up_rate&quot;*&quot;Babies_(S)&quot;</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="age up to child (I)">
				<eqn>&quot;baby_age-up_rate&quot; * &quot;Babies_(I)&quot;</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Age up to child (H)">
				<eqn>&quot;baby_age-up_rate&quot; * &quot;Babies_(H)&quot;</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Child vaccination">
				<eqn> Child_vaccination_proportion * vaccination_scale_factor</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Child infections">
				<eqn> IF Total_infectious &gt;= 1 THEN (Total_infectious / Total_population) * &quot;Children_(S)&quot; * Child_inf_weight ELSE 0</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Child recovery">
				<eqn>&quot;Children_(I)&quot; / infection_period</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Child hospitalisation">
				<eqn>&quot;Children_(I)&quot; * Hosp_rate_child</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Child hospital recovery">
				<eqn>&quot;Children_(H)&quot; * Recovery_from_hospital_rate</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name='age up to "adult" (H)'>
				<eqn>&quot;child_age-up_rate&quot; * &quot;Children_(H)&quot;</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name='age up to "adult" (I)'>
				<eqn>&quot;child_age-up_rate&quot; * &quot;Children_(I)&quot;</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name='age up to "adult" (R)'>
				<eqn>&quot;child_age-up_rate&quot; * &quot;Children_(R)&quot;</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Adult vaccination">
				<eqn>&quot;Adults_(S)&quot; * Adult_vaccination_rate</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name='age up to "adult" (S)'>
				<eqn>&quot;child_age-up_rate&quot; * &quot;Children_(S)&quot;</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Adult infections">
				<eqn> IF Total_infectious &gt;= 1 THEN  (Total_infectious / Total_population) * &quot;Adults_(S)&quot; * Adult_inf_weight ELSE 0</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Adult hospitalisation">
				<eqn>Hosp_rate_adult * &quot;Adults_(I)&quot;</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Adult recovery">
				<eqn>&quot;Adults_(I)&quot; / infection_period</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Adult ACM (S)">
				<eqn>&quot;Adults_(S)&quot; * ACMR_Adults</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Adult ACM (R)">
				<eqn>&quot;Adults_(R)&quot; * ACMR_Adults</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Adult ACM (I)">
				<eqn>&quot;Adults_(I)&quot; * ACMR_Adults</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Adult ACM (H)">
				<eqn>&quot;Adults_(H)&quot; * ACMR_Adults</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Baby measles mortality">
				<eqn>&quot;Babies_(H)&quot; * Hospital_mortality_rate</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Child measles mortality">
				<eqn>&quot;Children_(H)&quot; * Hospital_mortality_rate</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Adult measles mortality">
				<eqn>&quot;Adults_(H)&quot; * Hospital_mortality_rate</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<stock name="Measles Deaths">
				<eqn>0</eqn>
				<inflow>Child_measles_mortality</inflow>
				<inflow>Baby_measles_mortality</inflow>
				<inflow>Adult_measles_mortality</inflow>
				<non_negative/>
				<units>people</units>
			</stock>
			<flow name="Child migration (S)">
				<eqn>&quot;child_(S)_migration_rate&quot;</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Adult migration (S)">
				<eqn>&quot;adult_(S)_migration_rate&quot;</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Child migration (R)">
				<eqn>&quot;child_(R)_migration_rate&quot;</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Adult (R) migration">
				<eqn>&quot;adult_(R)_migration_rate&quot;</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<aux name="birth rate">
				<eqn>16346/365</eqn>
				<units>per Year</units>
			</aux>
			<aux name="baby migration rate">
				<eqn>196/365</eqn>
				<units>per Year</units>
			</aux>
			<aux name="baby age-up rate">
				<eqn>1/365</eqn>
				<units>per Year</units>
			</aux>
			<aux name="child (S) migration rate">
				<eqn>80.1/365</eqn>
				<units>per Year</units>
			</aux>
			<aux name="child age-up rate">
				<eqn>1/4/365</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="adult (S) migration rate">
				<eqn>572.7/365</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="adult (R) migration rate">
				<eqn>5732.5/365</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="child (R) migration rate">
				<eqn>801.7/365</eqn>
			</aux>
			<aux name="Adult vaccination rate">
				<eqn>0</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="Total infectious">
				<eqn>&quot;Babies_(I)&quot; + &quot;Children_(I)&quot; + &quot;Adults_(I)&quot;</eqn>
			</aux>
			<aux name="R0">
				<eqn>13.5</eqn>
			</aux>
			<aux name="Total recovered">
				<eqn>&quot;Babies_(R)&quot; + &quot;Children_(R)&quot; + &quot;Adults_(R)&quot;</eqn>
			</aux>
			<aux name="Total susceptible">
				<eqn>&quot;Babies_(S)&quot; + &quot;Children_(S)&quot; + &quot;Adults_(S)&quot;</eqn>
			</aux>
			<aux name="Total hospitalised">
				<eqn>&quot;Babies_(H)&quot; + &quot;Children_(H)&quot; + &quot;Adults_(H)&quot;</eqn>
			</aux>
			<aux name="Total population">
				<eqn>Total_susceptible + Total_infected + Total_recovered + Total_hospitalised</eqn>
			</aux>
			<aux name="infection period">
				<eqn>8.75</eqn>
				<units>Years</units>
			</aux>
			<aux name="Hosp rate baby">
				<eqn>1.89 * Hosp_rate_adult</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="Recovery from hospital rate">
				<eqn>0.5</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="Hospital mortality rate">
				<eqn>0.167</eqn>
				<units>Per Year</units>
			</aux>
			<flow name="Adult hospital recovery">
				<eqn>&quot;Adults_(H)&quot; * Recovery_from_hospital_rate</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<aux name="Child vaccination proportion">
				<eqn>15360/365</eqn>
			</aux>
			<aux name="ACMR Adults">
				<eqn>0.00723/365</eqn>
				<units>Per Year</units>
			</aux>
			<stock name="Babies (X)">
				<eqn>0</eqn>
				<inflow>Baby_hospital_recovery</inflow>
				<inflow>Baby_isolation</inflow>
				<outflow>Baby_recovery_X</outflow>
				<outflow>&quot;Age_up_to_child_(X)&quot;</outflow>
				<outflow>&quot;Baby_hospitalisation_(X)&quot;</outflow>
				<outflow>&quot;Baby_ACM_(X)&quot;</outflow>
				<non_negative/>
				<units>people</units>
			</stock>
			<flow name="Baby isolation">
				<eqn>&quot;Babies_(I)&quot; * isolation_switch</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<stock name="Children (X)">
				<eqn>0</eqn>
				<inflow>Child_hospital_recovery</inflow>
				<inflow>Child_isolation</inflow>
				<inflow>&quot;Age_up_to_child_(X)&quot;</inflow>
				<outflow>Child_recovery_X</outflow>
				<outflow>&quot;age_up_to_\&quot;adult\&quot;_(X)&quot;</outflow>
				<outflow>&quot;Child_hospitalisation_(X)&quot;</outflow>
				<outflow>&quot;Child_ACM_(R)_1&quot;</outflow>
				<non_negative/>
				<units>people</units>
			</stock>
			<flow name="Baby recovery X">
				<eqn>&quot;Babies_(X)&quot; / infection_period</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Child isolation">
				<eqn>&quot;Children_(I)&quot; * isolation_switch</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Child recovery X">
				<eqn>&quot;Children_(X)&quot;/infection_period</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Age up to child (X)">
				<eqn>&quot;Babies_(X)&quot; * &quot;baby_age-up_rate&quot;</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<stock name="Adults (X)">
				<eqn>0</eqn>
				<inflow>Adult_hospital_recovery</inflow>
				<inflow>Adult_isolation</inflow>
				<inflow>&quot;age_up_to_\&quot;adult\&quot;_(X)&quot;</inflow>
				<outflow>&quot;Adult_recovery_(X)&quot;</outflow>
				<outflow>&quot;Adult_hospitalisation_(X)&quot;</outflow>
				<outflow>&quot;Adult_ACM_(X)&quot;</outflow>
				<non_negative/>
				<units>people</units>
			</stock>
			<flow name="Adult isolation">
				<eqn>&quot;Adults_(I)&quot; * isolation_switch</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Adult recovery (X)">
				<eqn>&quot;Adults_(X)&quot;/infection_period</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name='age up to "adult" (X)'>
				<eqn>&quot;Children_(X)&quot; * &quot;child_age-up_rate&quot;</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<aux name="Isolation delay">
				<eqn>55.18182</eqn>
			</aux>
			<aux name="Isolation proportion">
				<eqn>0.09363636</eqn>
			</aux>
			<aux name="isolation switch">
				<eqn>IF Total_infected &gt;= 1 THEN DELAY(Isolation_proportion, Isolation_delay,  0) ELSE 

(IF PREVIOUS(SELF, 0) = Isolation_proportion AND Total_infected &lt; 1 THEN DELAY(0,  38,  Isolation_proportion) ELSE 0)</eqn>
			</aux>
			<group name="Isolation Switch Model" run="false">
				<entity name="Isolation_delay"/>
				<entity name="Isolation_proportion"/>
				<entity name="isolation_switch"/>
			</group>
			<flow name="Infected adults input">
				<eqn>0</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<aux name="Total isolated">
				<eqn>&quot;Babies_(X)&quot; + &quot;Children_(X)&quot; + &quot;Adults_(X)&quot;</eqn>
			</aux>
			<aux name="Total infected">
				<eqn>Total_isolated + Total_infectious</eqn>
			</aux>
			<flow name="Baby hospitalisation (X)">
				<eqn>&quot;Babies_(X)&quot; * Hosp_rate_baby</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Child hospitalisation (X)">
				<eqn>&quot;Children_(X)&quot; * Hosp_rate_child</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Adult hospitalisation (X)">
				<eqn>&quot;Adults_(X)&quot; * Hosp_rate_adult</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<stock name="Babies (R)">
				<eqn>0</eqn>
				<inflow>Baby_recovery</inflow>
				<inflow>Baby_recovery_X</inflow>
				<outflow>&quot;age_up_to_child_(R)&quot;</outflow>
				<outflow>&quot;Baby_ACM_(R)&quot;</outflow>
				<non_negative/>
				<units>people</units>
			</stock>
			<aux name="ACMR Children">
				<eqn>0.00100/365</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="ACMR Babies">
				<eqn>0.00950/365</eqn>
				<units>Per Year</units>
			</aux>
			<flow name="Baby ACM (S)">
				<eqn>&quot;Babies_(S)&quot; * ACMR_Babies</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Baby ACM (R)">
				<eqn>&quot;Babies_(R)&quot; * ACMR_Babies</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Baby ACM (I)">
				<eqn>&quot;Babies_(I)&quot; * ACMR_Babies</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Baby ACM (H)">
				<eqn>&quot;Babies_(H)&quot; * ACMR_Babies</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Baby ACM (X)">
				<eqn>&quot;Babies_(X)&quot; * ACMR_Babies</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Child ACM (S)">
				<eqn>&quot;Children_(S)&quot; * ACMR_Children</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Child ACM (R)">
				<eqn>&quot;Children_(R)&quot; * ACMR_Children</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Child ACM (H) 1">
				<eqn>&quot;Children_(H)&quot; * ACMR_Children</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Child ACM (R) 1">
				<eqn>&quot;Children_(X)&quot; * ACMR_Children</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Child ACM (I)">
				<eqn>&quot;Children_(I)&quot; * ACMR_Children</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<flow name="Adult ACM (X)">
				<eqn>&quot;Adults_(X)&quot; * ACMR_Adults</eqn>
				<non_negative/>
				<units>people/days</units>
			</flow>
			<aux name="Adult inf weight">
				<eqn>1.27</eqn>
			</aux>
			<aux name="Child inf weight">
				<eqn>6.20</eqn>
			</aux>
			<aux name="Baby inf weight">
				<eqn>2.52</eqn>
			</aux>
			<aux name="New cases">
				<eqn>Baby_infections + Child_infections + Adult_infections</eqn>
			</aux>
			<aux name="Baby hospitalisation total">
				<eqn>Baby_hospitalisation + &quot;Baby_hospitalisation_(X)&quot;</eqn>
			</aux>
			<aux name="Child hospitalisation total">
				<eqn>Child_hospitalisation + &quot;Child_hospitalisation_(X)&quot;</eqn>
			</aux>
			<aux name="Adult hospitalisation total">
				<eqn>Adult_hospitalisation + &quot;Adult_hospitalisation_(X)&quot;</eqn>
			</aux>
			<aux name="Hosp rate child">
				<eqn>0.940*Hosp_rate_adult</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="Hosp rate adult">
				<eqn>0.039</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="New Admissions">
				<eqn>Adult_hospitalisation_total + Baby_hospitalisation_total + Child_hospitalisation_total</eqn>
			</aux>
			<aux name="vaccination scale factor">
				<eqn>0.9</eqn>
			</aux>
		</variables>
