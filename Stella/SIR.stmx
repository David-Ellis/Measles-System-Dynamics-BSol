<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>SIR</name>
		<uuid>eed773d1-f4f7-4725-8d05-452b96d4f2dc</uuid>
		<vendor>isee systems, inc.</vendor>
		<product version="3.8.1" isee:build_number="3623" isee:saved_by_v1="true" lang="en">Stella Architect</product>
	</header>
	<sim_specs isee:sim_duration="1.5" isee:run_prefix="Run" isee:simulation_delay="0.00428571" isee:restore_on_start="false" method="Euler" time_units="days" isee:instantaneous_flows="false" isee:ignore_module_errors="false" isee:strict_units="true" isee:loop_scores="true" isee:loop_exhaustive_allowed="1000">
		<start>0</start>
		<stop>350</stop>
		<dt reciprocal="true">10</dt>
	</sim_specs>
	<isee:prefs saved_runs="10" keep="false" show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="false" layer="suggesting" isee:design="Deluxe Prev-Next Blue Green Pastel" isee:design_custom="false" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" rerun_on_structure_change="true" rifp="true"/>
	<isee:multiplayer_settings include_chat="true" allow_observers="false" advance_time_increment="1" max_advance_time_in_ms="0" model_stops_when_players_drop="false" observer_start_page="home_page" enabled="false"/>
	<isee:time_formats default_format="Builtin">
		<isee:time_format name="Builtin" type="adaptive"/>
	</isee:time_formats>
	<isee:number_format_extenders/>
	<default_format/>
	<isee:sensi_specs_list active_index="0">
		<isee:sensi_specs name="Sensitivity" method="grid">
			<isee:variable starting_value="0" ending_value="20" type="incremental" min="0" max="20" seed="12345" name="isolation_delay" num_samples="5"/>
		</isee:sensi_specs>
	</isee:sensi_specs_list>
	<isee:optimizer_specs_list active_index="0">
		<isee:optimizer_specs name="Optimization" method="Powell" use_additional_starts_file="false" additional_starts="0" report_interval="1" confidence_range="0"/>
	</isee:optimizer_specs_list>
	<isee:payoff_specs_list>
		<isee:payoff_specs name="Payoff"/>
	</isee:payoff_specs_list>
	<model_units>
		<unit name="Days">
			<eqn/>
			<alias>day</alias>
		</unit>
	</model_units>
	<model>
		<variables>
			<stock name="susceptible 1">
				<eqn>1.3e5/(1.3e5 + 1.17e6)</eqn>
				<outflow>Flow_3</outflow>
				<non_negative/>
			</stock>
			<stock name="infected 1">
				<eqn>1/1.3e6</eqn>
				<inflow>Flow_3</inflow>
				<outflow>Flow_4</outflow>
				<non_negative/>
			</stock>
			<stock name="recovered 1">
				<eqn>1.17e6/(1.3e5 + 1.17e6)</eqn>
				<inflow>Flow_4</inflow>
				<non_negative/>
			</stock>
			<flow name="Flow 3">
				<eqn>R0_1 * R0_scale /infectious_period_1 * susceptible_1 * infected_1 / N2</eqn>
				<non_negative/>
			</flow>
			<flow name="Flow 4">
				<eqn>infected_1 / infectious_period_1</eqn>
				<non_negative/>
			</flow>
			<aux name="R0 1">
				<eqn>13.5</eqn>
			</aux>
			<aux name="infectious period 1">
				<eqn>8.75</eqn>
				<units>Days</units>
			</aux>
			<aux name="N2">
				<eqn>1</eqn>
			</aux>
			<aux name="R0 scale">
				<eqn>0.75</eqn>
			</aux>
			<stock name="Susceptible">
				<eqn>1.3e5</eqn>
				<outflow>infections</outflow>
				<non_negative/>
			</stock>
			<stock name="Infected">
				<eqn>0</eqn>
				<inflow>infections</inflow>
				<outflow>recovery</outflow>
				<outflow>isolation</outflow>
				<non_negative/>
			</stock>
			<stock name="Recovered">
				<eqn>1.17e6</eqn>
				<inflow>recovery</inflow>
				<inflow>recovery_from_isolation</inflow>
				<non_negative/>
			</stock>
			<flow name="infections">
				<eqn>IF Infected &gt;= 1 THEN R0 /infectious_period * Susceptible * Infected / N ELSE 0</eqn>
				<non_negative/>
			</flow>
			<flow name="recovery">
				<eqn>Infected / infectious_period</eqn>
				<non_negative/>
			</flow>
			<aux name="R0">
				<eqn>13.5</eqn>
			</aux>
			<aux name="infectious period">
				<eqn>8.75</eqn>
				<units>Days</units>
			</aux>
			<aux name="N">
				<eqn>1.3e5 + 1.17e6</eqn>
			</aux>
			<aux name="Total infected">
				<eqn>Infected + Isolated</eqn>
			</aux>
			<flow name="isolation">
				<eqn>Infected * isolation_switch * isolation_proportion</eqn>
				<non_negative/>
			</flow>
			<flow name="recovery from isolation">
				<eqn>Isolated / infectious_period</eqn>
				<non_negative/>
			</flow>
			<stock name="Isolated">
				<eqn>0</eqn>
				<inflow>isolation</inflow>
				<outflow>recovery_from_isolation</outflow>
				<non_negative/>
			</stock>
			<aux name="isolation switch">
				<eqn>IF Infected &gt;= 1 THEN DELAY(Infected &gt;= 1, isolation_delay,  0) ELSE 

(IF PREVIOUS(SELF, 0) = 1 AND Infected &lt; 1 THEN DELAY(Infected &gt; 1,  36,  1) ELSE 0)</eqn>
			</aux>
			<aux name="isolation delay">
				<eqn>50</eqn>
			</aux>
			<aux name="isolation proportion">
				<eqn>0.078</eqn>
			</aux>
			<aux name="parents willingness to vaccinate">
				<eqn>Health_literacy</eqn>
			</aux>
			<aux name="Recent cases/admissions">
				<eqn>100</eqn>
			</aux>
			<aux name="Misinformation">
				<eqn>100</eqn>
			</aux>
			<aux name="accessibility">
				<eqn>100</eqn>
			</aux>
			<aux name="Vaccination rate">
				<eqn>accessibility</eqn>
			</aux>
			<aux name="Fear of the vaccine">
				<eqn>recent_adverse_reactions</eqn>
			</aux>
			<aux name="recent adverse reactions">
				<eqn>100</eqn>
			</aux>
			<aux name="Health literacy">
				<eqn>100</eqn>
			</aux>
			<aux name="Fear of the disease">
				<eqn>&quot;Recent_cases/admissions&quot;</eqn>
			</aux>
		</variables>
