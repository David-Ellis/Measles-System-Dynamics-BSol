<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>basic-model</name>
		<uuid>eed773d1-f4f7-4725-8d05-452b96d4f2dc</uuid>
		<vendor>isee systems, inc.</vendor>
		<product version="3.8.1" isee:build_number="3623" isee:saved_by_v1="true" lang="en">Stella Architect</product>
	</header>
	<sim_specs isee:sim_duration="1.5" isee:run_prefix="Run" isee:simulation_delay="1.5" isee:restore_on_start="false" method="Euler" time_units="Years" isee:instantaneous_flows="false" isee:ignore_module_errors="false" isee:strict_units="true" isee:loop_scores="true" isee:loop_exhaustive_allowed="1000" isee:analyze_mode="false">
		<start>0</start>
		<stop>1</stop>
		<dt reciprocal="true">365</dt>
	</sim_specs>
	<isee:prefs saved_runs="5" keep="false" show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="false" layer="model" isee:design="Deluxe Prev-Next Blue Green Pastel" isee:design_custom="false" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" rerun_on_structure_change="false" rifp="true"/>
	<isee:multiplayer_settings include_chat="true" allow_observers="false" advance_time_increment="1" max_advance_time_in_ms="0" model_stops_when_players_drop="false" observer_start_page="home_page" enabled="false"/>
	<isee:time_formats default_format="Builtin">
		<isee:time_format name="Builtin" type="adaptive"/>
	</isee:time_formats>
	<isee:number_format_extenders/>
	<default_format/>
	<model_units>
		<unit name="People">
			<eqn/>
			<alias>person</alias>
			<alias>persons</alias>
		</unit>
		<unit name="Years">
			<eqn/>
			<alias>yr</alias>
			<alias>year</alias>
		</unit>
		<unit name="Per Year">
			<eqn>1/Years</eqn>
		</unit>
	</model_units>
	<model>
		<variables>
			<flow name="Births">
				<eqn>Birth_rate</eqn>
				<non_negative/>
				<units>children/Years</units>
			</flow>
			<aux name="Birth rate">
				<eqn>16346</eqn>
				<units>Per year</units>
			</aux>
			<stock name="Babies &lt; 1 year">
				<eqn>16346</eqn>
				<inflow>Births</inflow>
				<inflow>Baby_migration</inflow>
				<outflow>Aging_past_1_year</outflow>
				<non_negative/>
				<units>children</units>
			</stock>
			<flow name="Baby migration">
				<eqn>Baby_migration_rate</eqn>
				<non_negative/>
				<units>children/Years</units>
			</flow>
			<aux name="Baby migration rate">
				<eqn>196</eqn>
				<units>Per Year</units>
			</aux>
			<flow name="Aging past 1 year">
				<eqn>&quot;Babies_&lt;_1_year&quot; * age_to_1_rate</eqn>
				<non_negative/>
				<units>children/Years</units>
			</flow>
			<aux name="age to 1 rate">
				<eqn>1</eqn>
			</aux>
			<stock name="Unvaccinated Child">
				<eqn>15543</eqn>
				<inflow>Aging_past_1_year</inflow>
				<inflow>Unvaccinated_child_migration</inflow>
				<outflow>MMR_vaccination_rate</outflow>
				<outflow>Age_out_of_system</outflow>
				<outflow>unvacc_infection</outflow>
				<non_negative/>
				<units>children</units>
			</stock>
			<stock name="Vaccinated Child">
				<eqn>54745</eqn>
				<inflow>MMR_vaccination_rate</inflow>
				<inflow>Vaccinated_child_migration</inflow>
				<outflow>Age_out_of_system_1</outflow>
				<non_negative/>
				<units>children</units>
			</stock>
			<flow name="MMR vaccination rate">
				<eqn>Unvaccinated_Child * MMR_vaccination_proportion</eqn>
				<non_negative/>
				<units>children/Years</units>
			</flow>
			<flow name="Age out of system">
				<eqn>Unvaccinated_Child*age_to_5_rate</eqn>
				<non_negative/>
				<units>children/Years</units>
			</flow>
			<flow name="Age out of system 1">
				<eqn>Vaccinated_Child * age_to_5_rate</eqn>
				<non_negative/>
				<units>children/Years</units>
			</flow>
			<aux name="MMR vaccination proportion">
				<eqn>0.789</eqn>
				<units>Per Year</units>
			</aux>
			<stock name="Unvaccinated Infected">
				<eqn>10</eqn>
				<inflow>unvacc_infection</inflow>
				<inflow>Sent_home</inflow>
				<outflow>Recovery</outflow>
				<outflow>Hospitalisation</outflow>
				<non_negative/>
				<units>children</units>
			</stock>
			<flow name="unvacc infection">
				<eqn> (R0 / infection_period) * (Unvaccinated_Infected / BSol_total_pop) * Unvaccinated_Child</eqn>
				<non_negative/>
				<units>children/Years</units>
			</flow>
			<stock name="Hospitalised">
				<eqn>0</eqn>
				<inflow>Hospitalisation</inflow>
				<outflow>Sent_home</outflow>
				<outflow>Died_from_hospital</outflow>
				<non_negative/>
				<units>children</units>
			</stock>
			<flow name="Hospitalisation">
				<eqn>Unvaccinated_Infected * Hospitalisation_rate</eqn>
				<non_negative/>
				<units>children/Years</units>
			</flow>
			<flow name="Died from hospital">
				<eqn>Hospitalised * Hospital_mortality_rate</eqn>
				<non_negative/>
				<units>children/Years</units>
			</flow>
			<flow name="Recovery">
				<eqn>Unvaccinated_Infected / infection_period * 0.9995</eqn>
				<non_negative/>
				<units>children/Years</units>
			</flow>
			<flow name="Sent home">
				<eqn>Hospitalised * Recovery_from_hospital_rate</eqn>
				<non_negative/>
				<units>children/Years</units>
			</flow>
			<stock name="Recovered">
				<eqn>0</eqn>
				<inflow>Recovery</inflow>
				<outflow>Age_out_of_system_2</outflow>
				<non_negative/>
				<units>children</units>
			</stock>
			<flow name="Age out of system 2">
				<eqn>Recovered * age_to_5_rate</eqn>
				<non_negative/>
				<units>children/Years</units>
			</flow>
			<aux name="Hospital mortality rate">
				<eqn>0.167*365</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="Hospitalisation rate">
				<eqn>0.0021*365</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="Recovery from hospital rate">
				<eqn>0.5*365</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="age to 5 rate">
				<eqn>1/4</eqn>
			</aux>
			<flow name="Unvaccinated child migration">
				<eqn>Unvaccinated_child_migration_rate</eqn>
				<non_negative/>
				<units>children/Years</units>
			</flow>
			<flow name="Vaccinated child migration">
				<eqn>vaccinated_child_migration_rate</eqn>
				<non_negative/>
				<units>children/Years</units>
			</flow>
			<aux name="Unvaccinated child migration rate">
				<eqn>80.1</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="vaccinated child migration rate">
				<eqn>801.7</eqn>
				<units>children/Years</units>
			</aux>
			<aux name="BSol total pop">
				<eqn>1.45e6</eqn>
				<units>people</units>
			</aux>
			<aux name="R0">
				<eqn>13.5*8</eqn>
			</aux>
			<aux name="infection period">
				<eqn>9/365</eqn>
				<units>Years</units>
			</aux>
			<aux name="Total infected"/>
		</variables>
