				<eqn>14620</eqn>
				<inflow>&quot;age_up_to_child_(S)&quot;</inflow>
				<inflow>&quot;Child_migration_(S)&quot;</inflow>
				<outflow>Child_vaccination</outflow>
				<outflow>Child_infections</outflow>
				<outflow>&quot;age_up_to_\&quot;adult\&quot;_(S)&quot;</outflow>
				<non_negative/>
				<units>people</units>
			</stock>
			<stock name="Children (R)">
				<eqn>69365</eqn>
				<inflow>&quot;age_up_to_child_(R)&quot;</inflow>
				<inflow>Child_vaccination</inflow>
				<inflow>Child_recovery</inflow>
				<inflow>&quot;Child_migration_(R)&quot;</inflow>
