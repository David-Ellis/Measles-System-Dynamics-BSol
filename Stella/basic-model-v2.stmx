		</unit>
		<unit name="Per Year">
			<eqn>1/Years</eqn>
		</unit>
	</model_units>
	<model>
		<variables>
			<stock name="Babies (S)">
				<eqn>16346</eqn>
				<inflow>Births</inflow>
				<inflow>&quot;Baby_migration_(S)&quot;</inflow>
