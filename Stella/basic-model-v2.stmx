				<non_negative/>
				<units>people</units>
			</stock>
			<stock name="Children (I)">
				<eqn>0</eqn>
				<inflow>&quot;age_up_to_child_(I)&quot;</inflow>
				<inflow>Child_infections</inflow>
				<inflow>Child_hospital_recovery</inflow>
				<outflow>Child_recovery</outflow>
				<outflow>Child_hospitalisation</outflow>
				<outflow>&quot;age_up_to_\&quot;adult\&quot;_(I)&quot;</outflow>
				<non_negative/>
				<units>people</units>
			</stock>
			<stock name="Children (H)">
				<eqn>0</eqn>
				<inflow>&quot;Age_up_to_child_(H)&quot;</inflow>
				<inflow>Child_hospitalisation</inflow>
				<outflow>Child_hospital_recovery</outflow>
				<outflow>&quot;age_up_to_\&quot;adult\&quot;_(H)&quot;</outflow>
				<outflow>Child_measles_mortality</outflow>
				<non_negative/>
				<units>people</units>
			</stock>
			<stock name="Adults (S)">
				<eqn>136364</eqn>
				<inflow>&quot;age_up_to_\&quot;adult\&quot;_(S)&quot;</inflow>
				<inflow>&quot;Adult_migration_(S)&quot;</inflow>
				<outflow>Adult_vaccination</outflow>
				<outflow>Adult_infections</outflow>
				<outflow>&quot;Adult_(S)_mortality&quot;</outflow>
				<non_negative/>
				<units>people</units>
			</stock>
			<stock name="Adults (R)">
				<eqn>1138068</eqn>
				<inflow>&quot;age_up_to_\&quot;adult\&quot;_(R)&quot;</inflow>
				<inflow>Adult_vaccination</inflow>
				<inflow>Adult_recovery</inflow>
				<inflow>&quot;Adult_(R)_migration&quot;</inflow>
				<outflow>&quot;Adult_(R)_mortality&quot;</outflow>
				<non_negative/>
				<units>people</units>
			</stock>
			<stock name="Adults (I)">
				<eqn>1</eqn>
				<inflow>&quot;age_up_to_\&quot;adult\&quot;_(I)&quot;</inflow>
				<inflow>Adult_infections</inflow>
				<inflow>Infected_adults_input</inflow>
				<inflow>Adult_hospital_recovery</inflow>
				<outflow>Adult_hospitalisation</outflow>
				<outflow>Adult_recovery</outflow>
				<outflow>&quot;Adults_(I)_mortality&quot;</outflow>
				<non_negative/>
				<units>people</units>
			</stock>
			<stock name="Adults (H)">
				<eqn>0</eqn>
				<inflow>&quot;age_up_to_\&quot;adult\&quot;_(H)&quot;</inflow>
				<inflow>Adult_hospitalisation</inflow>
				<outflow>&quot;Adults_(H)_mortality&quot;</outflow>
				<outflow>Adult_measles_mortality</outflow>
				<outflow>Adult_hospital_recovery</outflow>
				<non_negative/>
				<units>people</units>
			</stock>
			<flow name="Births">
				<eqn>birth_rate</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Baby migration (S)">
				<eqn>baby_migration_rate</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Baby infections">
				<eqn> (R0 / infection_period) * (Total_infected / Total_population) * &quot;Babies_(S)&quot;</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Baby recovery">
				<eqn>&quot;Babies_(I)&quot; / infection_period</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Baby hospitalisation">
				<eqn>&quot;Babies_(I)&quot; * Hospitalisation_rate</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Baby hospital recovery">
				<eqn>&quot;Babies_(H)&quot; * Recovery_from_hospital_rate</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="age up to child (R)">
				<eqn>&quot;baby_age-up_rate&quot; * &quot;Babies_(R)&quot;</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="age up to child (S)">
				<eqn>&quot;baby_age-up_rate&quot;*&quot;Babies_(S)&quot;</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="age up to child (I)">
				<eqn>&quot;baby_age-up_rate&quot; * &quot;Babies_(I)&quot;</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Age up to child (H)">
				<eqn>&quot;baby_age-up_rate&quot; * &quot;Babies_(H)&quot;</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Child vaccination">
				<eqn>&quot;Children_(S)&quot; * Child_vaccination_proportion</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Child infections">
				<eqn> (R0 / infection_period) * (Total_infected / Total_population) * &quot;Children_(S)&quot;</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Child recovery">
				<eqn>&quot;Children_(I)&quot; / infection_period</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Child hospitalisation">
				<eqn>&quot;Children_(I)&quot; * Hospitalisation_rate</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Child hospital recovery">
				<eqn>&quot;Children_(H)&quot; * Recovery_from_hospital_rate</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name='age up to "adult" (H)'>
				<eqn>&quot;child_age-up_rate&quot; * &quot;Children_(H)&quot;</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name='age up to "adult" (I)'>
				<eqn>&quot;child_age-up_rate&quot; * &quot;Children_(I)&quot;</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name='age up to "adult" (R)'>
				<eqn>&quot;child_age-up_rate&quot; * &quot;Children_(R)&quot;</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Adult vaccination">
				<eqn>&quot;Adults_(S)&quot; * Adult_vaccination_rate</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name='age up to "adult" (S)'>
				<eqn>&quot;child_age-up_rate&quot; * &quot;Children_(S)&quot;</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Adult infections">
				<eqn> (R0 / infection_period) * (Total_infected / Total_population) * &quot;Adults_(S)&quot;</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Adult hospitalisation">
				<eqn>Hospitalisation_rate * &quot;Adults_(I)&quot;</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Adult recovery">
				<eqn>&quot;Adults_(I)&quot; / infection_period</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Adult (S) mortality">
				<eqn>&quot;Adults_(S)&quot; * General_adult_mortality_rate</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Adult (R) mortality">
				<eqn>&quot;Adults_(R)&quot; * General_adult_mortality_rate</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Adults (I) mortality">
				<eqn>&quot;Adults_(I)&quot; * General_adult_mortality_rate</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Adults (H) mortality">
				<eqn>&quot;Adults_(H)&quot; * General_adult_mortality_rate</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Baby measles mortality">
				<eqn>&quot;Babies_(H)&quot; * Hospital_mortality_rate</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Child measles mortality">
				<eqn>&quot;Children_(H)&quot; * Hospital_mortality_rate</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Adult measles mortality">
				<eqn>&quot;Adults_(H)&quot; * Hospital_mortality_rate</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<stock name="Measles Deaths">
				<eqn>0</eqn>
				<inflow>Child_measles_mortality</inflow>
				<inflow>Baby_measles_mortality</inflow>
				<inflow>Adult_measles_mortality</inflow>
				<non_negative/>
				<units>people</units>
			</stock>
			<flow name="Child migration (S)">
				<eqn>&quot;child_(S)_migration_rate&quot;</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Adult migration (S)">
				<eqn>&quot;adult_(S)_migration_rate&quot;</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Child migration (R)">
				<eqn>&quot;child_(R)_migration_rate&quot;</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Adult (R) migration">
				<eqn>&quot;adult_(R)_migration_rate&quot;</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<flow name="Infected adults input">
				<eqn>0</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<aux name="birth rate">
				<eqn>16346</eqn>
				<units>per Year</units>
			</aux>
			<aux name="baby migration rate">
				<eqn>196</eqn>
				<units>per Year</units>
			</aux>
			<aux name="baby age-up rate">
				<eqn>1</eqn>
				<units>per Year</units>
			</aux>
			<aux name="child (S) migration rate">
				<eqn>80.1</eqn>
				<units>per Year</units>
			</aux>
			<aux name="child age-up rate">
				<eqn>1/4</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="adult (S) migration rate">
				<eqn>572.7</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="adult (R) migration rate">
				<eqn>5732.5</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="child (R) migration rate">
				<eqn>801.7</eqn>
			</aux>
			<aux name="Adult vaccination rate">
				<eqn>0</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="Total infected">
				<eqn>&quot;Babies_(I)&quot; + &quot;Children_(I)&quot; + &quot;Adults_(I)&quot;</eqn>
			</aux>
			<aux name="R0">
				<eqn>13.5</eqn>
			</aux>
			<aux name="Total recovered">
				<eqn>&quot;Babies_(R)&quot; + &quot;Children_(R)&quot; + &quot;Adults_(R)&quot;</eqn>
			</aux>
			<aux name="Total susceptible">
				<eqn>&quot;Babies_(S)&quot; + &quot;Children_(S)&quot; + &quot;Adults_(S)&quot;</eqn>
			</aux>
			<aux name="Total hospitalised">
				<eqn>&quot;Babies_(H)&quot; + &quot;Children_(H)&quot; + &quot;Adults_(H)&quot;</eqn>
			</aux>
			<aux name="Total population">
				<eqn>Total_susceptible + Total_infected + Total_recovered + Total_hospitalised</eqn>
			</aux>
			<aux name="infection period">
				<eqn>9/365</eqn>
				<units>Years</units>
			</aux>
			<aux name="Hospitalisation rate">
				<eqn>0.0021*365</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="Recovery from hospital rate">
				<eqn>0.5*365</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="Hospital mortality rate">
				<eqn>0.167*365</eqn>
				<units>Per Year</units>
			</aux>
			<flow name="Adult hospital recovery">
				<eqn>&quot;Adults_(H)&quot; * Recovery_from_hospital_rate</eqn>
				<non_negative/>
				<units>people/Years</units>
			</flow>
			<aux name="Child vaccination proportion">
				<eqn>0.789</eqn>
			</aux>
			<aux name="General adult mortality rate">
				<eqn>0.009</eqn>
				<units>Per Year</units>
			</aux>
		</variables>
