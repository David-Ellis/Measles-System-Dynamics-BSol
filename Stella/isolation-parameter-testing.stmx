<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>isolation-parameter-testing</name>
		<uuid>eed773d1-f4f7-4725-8d05-452b96d4f2dc</uuid>
		<vendor>isee systems, inc.</vendor>
		<product version="3.8.1" isee:build_number="3623" isee:saved_by_v1="true" lang="en">Stella Architect</product>
	</header>
	<sim_specs isee:sim_duration="1.5" isee:run_prefix="Run" isee:simulation_delay="0.00410959" isee:restore_on_start="false" method="Euler" time_units="days" isee:instantaneous_flows="false" isee:ignore_module_errors="false" isee:strict_units="true" isee:loop_scores="true" isee:loop_exhaustive_allowed="1000" isee:analyze_mode="false">
		<start>0</start>
		<stop>365</stop>
		<dt reciprocal="true">4</dt>
	</sim_specs>
	<isee:prefs saved_runs="10" keep="false" show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="false" layer="model" isee:design="Deluxe Prev-Next Blue Green Pastel" isee:design_custom="false" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" rerun_on_structure_change="false" rifp="true"/>
	<isee:multiplayer_settings include_chat="true" allow_observers="false" advance_time_increment="1" max_advance_time_in_ms="0" model_stops_when_players_drop="false" observer_start_page="home_page" enabled="false"/>
	<isee:time_formats default_format="Builtin">
		<isee:time_format name="Builtin" type="adaptive"/>
	</isee:time_formats>
	<isee:number_format_extenders/>
	<default_format/>
	<data>
		<export resource="r../output.xlsx" type="Excel" worksheet="Sheet1" interval="1" precomputed="false" isee:format="numbers">
			<all/>
		</export>
	</data>
	<isee:sensi_specs_list active_index="0">
		<isee:sensi_specs name="Sensitivity" method="grid"/>
	</isee:sensi_specs_list>
	<isee:optimizer_specs_list active_index="0">
		<isee:optimizer_specs name="Optimization" method="Powell" use_additional_starts_file="false" additional_starts="0" report_interval="1" confidence_range="0"/>
	</isee:optimizer_specs_list>
	<isee:payoff_specs_list>
		<isee:payoff_specs name="Payoff"/>
	</isee:payoff_specs_list>
	<model_units>
		<unit name="Days">
			<eqn/>
			<alias>day</alias>
		</unit>
	</model_units>
	<model>
		<variables>
			<stock name="Susceptible">
				<eqn>1.3e5</eqn>
				<outflow>Infections</outflow>
				<non_negative/>
			</stock>
			<stock name="Infected">
				<eqn>1</eqn>
				<inflow>Infections</inflow>
				<outflow>Recovery_1</outflow>
				<outflow>Isolation</outflow>
				<non_negative/>
			</stock>
			<stock name="Recovered">
				<eqn>1.17e6</eqn>
				<inflow>Recovery_1</inflow>
				<inflow>Recovery_2</inflow>
				<non_negative/>
			</stock>
			<flow name="Infections">
				<eqn>IF Infected &gt;= 1 THEN R0 /Infectious_period * Susceptible * Infected / N ELSE 0</eqn>
				<non_negative/>
			</flow>
			<flow name="Recovery 1">
				<eqn>Infected / Infectious_period</eqn>
				<non_negative/>
			</flow>
			<aux name="R0">
				<eqn>13.5</eqn>
			</aux>
			<aux name="Infectious period">
				<eqn>8.75</eqn>
				<units>Days</units>
			</aux>
			<aux name="N">
				<eqn>1.3e5 + 1.17e6</eqn>
			</aux>
			<stock name="Isolated">
				<eqn>1/1.3e6</eqn>
				<inflow>Isolation</inflow>
				<outflow>Recovery_2</outflow>
				<non_negative/>
			</stock>
			<aux name="isolation switch">
				<eqn>IF (historical_infections &gt; isolation_threshold AND new_case_average &gt; 1/38) THEN isolation_proportion ELSE 0</eqn>
			</aux>
			<flow name="Recovery 2">
				<eqn>Isolated / Infectious_period</eqn>
				<non_negative/>
			</flow>
			<aux name="Total infected">
				<eqn>Infected + Isolated</eqn>
			</aux>
			<aux name="historical infections">
				<eqn>RUNMAX(Total_infected)</eqn>
				<isee:delay_aux/>
			</aux>
			<flow name="Isolation">
				<eqn>Infected * isolation_switch</eqn>
				<non_negative/>
			</flow>
			<aux name="Probable testing curve">
				<eqn>SMTH1(Total_infected,  8.75,  0)</eqn>
				<isee:delay_aux/>
			</aux>
			<aux name="isolation threshold">
				<eqn>71.8</eqn>
			</aux>
			<aux name="isolation proportion">
				<eqn>0.114</eqn>
			</aux>
			<aux name="new case average">
				<eqn>SMTH1(Infections,  38,  0)</eqn>
				<isee:delay_aux/>
			</aux>
		</variables>
